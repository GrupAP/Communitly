# Puertos del host. Copia este archivo a .env y cambia los que choquen con
# otro servicio que ya tengas corriendo.
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=8081

# --- Solo para un despliegue real (p. ej. Coolify) --------------------------
# En local no hace falta definir nada de aqui para abajo: cada variable ya
# tiene un valor por defecto que reproduce el comportamiento actual.

# URL publica del backend tal como la va a usar el NAVEGADOR de cada
# visitante (se compila dentro del bundle de Flutter web, no es configurable
# despues del build). Ejemplo: https://api.tudominio.com/api
# API_BASE=

# Genera uno nuevo, p. ej. con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=

# DJANGO_DEBUG=False

# Dominios donde sirves el backend, separados por coma (sin esquema).
# DJANGO_ALLOWED_HOSTS=api.tudominio.com

# Igual que ALLOWED_HOSTS pero con esquema: lo pide el login del admin
# detras de un proxy HTTPS como el de Coolify.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.tudominio.com

# Contraseña de las cuentas de ejemplo (estudiantes y gestores) que crea
# cargar_datos/cargar_eventos/cargar_solicitudes. El valor por defecto
# ('espol2026') es publico porque esta en el codigo: cambialo aqui antes de
# que alguien dependa de verdad de una cuenta de gestor.
# DJANGO_SEED_PASSWORD=

# En 1 (por defecto), cada arranque vuelve a cargar el catalogo y las cuentas
# de ejemplo (pisando cualquier edicion hecha desde /admin). Pasa a 0 despues
# del primer despliegue si vas a administrar el contenido desde ahi.
# SEED_DATA=1
